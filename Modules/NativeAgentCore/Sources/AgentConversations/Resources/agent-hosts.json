  {
    "id": "claude-code",
    "displayName": "Claude Code",
    "description": "A coding assistant that works in the terminal.",
    "aliases": [
      "claude code",
      "claude-code",
      "claudecode",
      "claude cli",
      "cc"
    ],
    "installMarkers": [
      "~/.local/bin/claude",
      "/opt/homebrew/bin/claude",
      "/usr/local/bin/claude",
      "~/.claude/local/claude"
    ],
    "configPath": "~/.claude.json",
    "format": "jsonMCPServers",
    "restartRequired": true,
    "restartNote": "required — it reads this file when a session starts, so a session that is already open keeps its current servers until it is restarted.",
    "documentation": "https://code.claude.com/docs/en/mcp",
    "requiresWorkspace": false,
    "settingsSupported": true,
    "bundleIDs": [],
    "a2aPorts": [],
    "configPaths": [
      "~/.claude.json"
    ],
    "commandLine": {
      "executable": "claude",
      "arguments": [
        "-p",
        "--output-format",
        "json",
        "--name",
        "{{session_name}}",
        "--",
        "{{message}}"
      ],
      "continuation": [
        "-p",
        "--output-format",
        "json",
        "--resume",
        "{{session}}",
        "--",
        "{{message}}"
      ],
      "capturesThreadID": true,
      "jsonResultReply": true,
      "resultFields": {
        "reply": "result",
        "session": "session_id",
        "status": "subtype",
        "success": "success",
        "error": "is_error",
        "errors": "errors"
      },
      "automaticMCPProbe": false,
      "permissionFlags": "claude",
      "timeoutSeconds": 300,
      "documentation": "https://code.claude.com/docs/en/headless",
      "minimumVersion": "2.1.76"
    },
    "searchPaths": [],
    "executables": [
      "claude"
    ],
    "discoveryWords": [
      "claude"
    ],
    "messagingPermissionsPath": "~/.claude/settings.json",
    "messagingPermissionSyntax": "doubleUnderscore"
  },
