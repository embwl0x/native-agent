#!/usr/bin/env bash
# NativeAgent pre-commit secret + personal-data guard.
#
# Runs gitleaks against STAGED changes only, using the repo's .gitleaks.toml
# (secret rules + owner personal-data rules). Blocks the commit if anything
# matches. Bypass for a known-safe commit with:  git commit --no-verify
#
# Install (once):  ./script/hooks/install.sh
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] BLOCKED: gitleaks is required. Install it with: brew install gitleaks" >&2
  exit 1
elif ! gitleaks git --staged --no-banner --redact -c "$ROOT/.gitleaks.toml"; then
  echo "" >&2
  echo "[pre-commit] BLOCKED: gitleaks found a secret or personal-data leak in staged changes." >&2
  echo "[pre-commit] Fix it, or if it is a verified false positive: git commit --no-verify" >&2
  exit 1
fi

# The classifier owns primitive recognition. Check a single immutable staged
# tree (source, policy, classifier and inventory), including deletions/moves.
if [[ -n "$(git diff --cached --name-only -- '*.swift' 'script/timer_inventory.tsv' 'docs/ARCHITECTURE_BLUEPRINT.md' 'script/hooks/pre-commit')" ]]; then
  snapshot="$(mktemp -d "${TMPDIR:-/tmp}/nativeagent-staged.XXXXXX")"
  trap 'rm -rf "$snapshot"' EXIT
  staged_tree="$(git write-tree)"
  git archive "$staged_tree" | tar -x -C "$snapshot"
  echo "[pre-commit] timer ownership in staged tree $staged_tree"
  swift "$snapshot/script/check_timer_inventory.swift" --repo "$snapshot" || {
    echo "[pre-commit] BLOCKED: staged timer source, policy and script/timer_inventory.tsv must agree (see check output)." >&2
    exit 1
  }
fi
