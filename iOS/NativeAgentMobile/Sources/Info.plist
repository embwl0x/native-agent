<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>NativeAgent</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo to share with your agent when you accept a camera request.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Share enabled place transitions and wake brief phone-presence readings when you move, even while NativeAgent is closed. Coordinates for these senses stay on this phone.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Save a place on this phone or share your current location when you accept a phone request.</string>
	<key>NSMotionUsageDescription</key>
	<string>Share motion estimates (stationary, walking, running, cycling or driving) and confidence with your paired Mac and its selected AI provider when you enable Motion.</string>
	<key>NSFocusStatusUsageDescription</key>
	<string>Share whether Focus is on with your paired Mac when you enable Focus.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Use the microphone for hands-free talk while a talk session is active, voice notes, and dictation to your agent.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Attach photos you choose to chat, or enable Photos today to share only a count of visible photos dated today with your paired Mac and its selected AI provider. Limited Access is enough for counting.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>When you enable Apple Music, share the Music app's playback state and available song title and artist with your paired Mac and its selected AI provider. No audio is shared.</string>
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Recognize your words on this device during hands-free talk. Also transcribe voice notes and dictation for your agent.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<key>NativeAgentAppGroupID</key>
	<string>$(NATIVEAGENT_IOS_APP_GROUP_ID)</string>
	<key>NativeAgentDeviceSync</key>
	<string>cloudkit</string>
	<key>NativeAgentICloudContainerID</key>
	<string>$(NATIVEAGENT_ICLOUD_CONTAINER_ID)</string>
	<key>NativeAgentMobileSourceKey</key>
	<string>$(NATIVEAGENT_MOBILE_SOURCE_KEY)</string>
	<key>NativeAgentNotificationGroup</key>
	<string>group.$(NATIVEAGENT_IOS_BUNDLE_ID).notifications</string>
	<key>NativeAgentPrivacyPolicyURL</key>
	<string>$(NATIVEAGENT_PRIVACY_POLICY_URL)</string>
	<key>NativeAgentSupportURL</key>
	<string>$(NATIVEAGENT_SUPPORT_URL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
