<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>NativeAgent</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo to share with your agent when you accept a camera request.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Let your agent know when you arrive at or leave places you enable, even while NativeAgent is closed.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Share your current location with your agent when you accept a phone request.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Listen to push-to-talk so you can dictate messages to your agent.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>NativeAgentMobile lets you attach photos from your library so your agent can see them in chat.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Convert your voice to text so your agent can read what you said.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<key>NativeAgentAppGroupID</key>
	<string>$(NATIVEAGENT_IOS_APP_GROUP_ID)</string>
	<key>NativeAgentDeviceSync</key>
	<string>cloudkit</string>
	<key>NativeAgentICloudContainerID</key>
	<string>$(NATIVEAGENT_ICLOUD_CONTAINER_ID)</string>
	<key>NativeAgentMobileSourceKey</key>
	<string>$(NATIVEAGENT_MOBILE_SOURCE_KEY)</string>
	<key>NativeAgentNotificationGroup</key>
	<string>group.$(NATIVEAGENT_IOS_BUNDLE_ID).notifications</string>
	<key>NativeAgentPrivacyPolicyURL</key>
	<string>$(NATIVEAGENT_PRIVACY_POLICY_URL)</string>
	<key>NativeAgentSupportURL</key>
	<string>$(NATIVEAGENT_SUPPORT_URL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
