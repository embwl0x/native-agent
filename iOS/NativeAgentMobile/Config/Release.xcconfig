// Keep local account material such as DEVELOPMENT_TEAM and hosted URLs, but
// reassert canonical distribution identifiers afterward so an old development
// profile cannot silently stamp a Release archive with legacy IDs.
#include? "Local.xcconfig"
#include "CanonicalIdentifiers.xcconfig"

// App Store builds must always contain the two public About links, even when
// no maintainer-local configuration file is present.
// An empty expansion separates the slashes so xcconfig does not start a comment.
NATIVEAGENT_PRIVACY_POLICY_URL = https:/$()/nativeagent.app/privacy
NATIVEAGENT_SUPPORT_URL = https:/$()/nativeagent.app/support
