# Build artifacts
.build/
.swiftpm/
# Local packages consume the root pins; their standalone lockfiles are generated.
/Modules/*/Package.resolved
**/build/
DerivedData/
*.xcresult/
dist/
/NativeAgent.xcodeproj/
/iOS/NativeAgentMobile/NativeAgentMobile.xcodeproj/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Secrets
.env
.env.*
*.pem
*.key
*.token
# Defense-in-depth: secrets currently rely on the blanket data/ ignore below,
# but a future re-include (!data/...) or a move out of data/ could otherwise
# commit credentials. These patterns block them regardless of location.
*secrets*.json
*secret*.json
*credentials*.json
*.p12
*.pfx
*.provisionprofile
*.mobileprovision
*.jks
*.keystore
.netrc
.npmrc
.pypirc
id_rsa
id_dsa
id_ecdsa
id_ed25519
data/secrets/
secrets/
.secrets/
senses/ledger/
senses/news/
chrome/lease-bindings.json

# Local-only signing, release, and privacy inputs.
local/
*.local.xcconfig
iOS/NativeAgentMobile/Config/Local.xcconfig
*.local.entitlements
privacy_denylist.*

# Local runtime state
.runtime/
*.log
daemon/*.bak.*

# IDE
.idea/
.vscode/

# Personal persona identity stays private; clean templates are committed.
persona/SOUL.md
persona/USER.md
persona/VOICE.md
persona/GROWTH.md
persona/*.lock
persona/AGENTS.md
persona/notes.jsonl
persona/*/notes.jsonl
persona/*.bak
# Ignore persona backups with suffixes after .bak.
persona/*.bak.*
# Per-persona local backups / private Agent vault digests stay local
persona/*/*.bak
persona/*/*.bak.*
persona/*/workspace/
# Agent-specific skill bodies are private persona content.
persona/skills/bodies/agent-*.md
# Agent inbox logs, worker reports and proofs stay private.
docs/agent_inbox/
# Keep every persona's identity files private.
persona/*/SOUL.md
persona/*/USER.md
persona/*/VOICE.md
persona/*/GROWTH.md
persona/*/AGENTS.md
persona/*/*.lock

# Runtime data stays local.
data/
!data/.gitkeep

# Workspace drafts, scratch and generated files stay local; retain .gitkeep.
workspace/*
!workspace/.gitkeep

.claude/
iOS/NativeAgentMobile/build/

# Ad-hoc working backups created by Agent during ops (registry/inbox edits)
.backups/
data.backup.*/

# Local Hermes builder coordination state is generated per worktree.
.hermes-builder/

# Hermes/codex agent job workspaces parked in the repo root (foreign embedded repos)
.hermes-*/

# Large embedding model staged into release builds; never in git
extras/embedding/
extras/codex/

# Local capture/replay data stays private.
tests/
DerivedData-ios/
