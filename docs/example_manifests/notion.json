{
  "schemaVersion": 1,
  "name": "notion",
  "version": "1.0.0",
  "type": "connector",
  "description": "Search, read, create, and append to Notion pages and databases via Notion OAuth.",
  "author": {
    "name": "Your Name",
    "email": "you@example.com",
    "url": "https://github.com/your-username"
  },
  "oauth": {
    "provider": "notion",
    "flow": "authorization_code",
    "deviceFlow": false,
    "scopes": [],
    "envVars": {
      "clientId": "NATIVEAGENT_NOTION_CLIENT_ID",
      "clientSecret": "NATIVEAGENT_NOTION_CLIENT_SECRET"
    },
    "redirectUri": "nativeagent://oauth/notion",
    "setup": "Create a public OAuth integration at https://www.notion.so/my-integrations, set NATIVEAGENT_NOTION_CLIENT_ID and NATIVEAGENT_NOTION_CLIENT_SECRET. Note: Notion uses HTTP Basic auth for token exchange.",
    "apiVersion": "2022-06-28"
  },
  "endpoints": {
    "baseUrl": "https://api.notion.com/v1",
    "authHeader": "Bearer {token}",
    "extraHeaders": {
      "Notion-Version": "2022-06-28"
    }
  },
  "tools": [
    {
      "name": "notion.search",
      "description": "Search pages and databases in the connected Notion workspace.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "max": { "type": "integer", "description": "Max results (default 10)." }
        },
        "required": ["query"]
      }
    },
    {
      "name": "notion.read_page",
      "description": "Read a Notion page and its block content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Notion page ID (UUID format)." }
        },
        "required": ["id"]
      }
    },
    {
      "name": "notion.create_page",
      "description": "Create a new Notion page inside a database or page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "parentId": { "type": "string", "description": "Parent database or page ID." },
          "parentType": { "type": "string", "enum": ["database", "page"], "description": "Type of parent (default: page)." },
          "title": { "type": "string" },
          "content": { "type": "string", "description": "Initial paragraph content (max 2000 chars)." }
        },
        "required": ["parentId", "title"]
      }
    },
    {
      "name": "notion.append_block",
      "description": "Append a paragraph block to an existing Notion page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pageId": { "type": "string" },
          "content": { "type": "string", "description": "Text to append (max 2000 chars)." }
        },
        "required": ["pageId", "content"]
      }
    },
    {
      "name": "notion.query_database",
      "description": "Query a Notion database with optional filter.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "databaseId": { "type": "string" },
          "filter": { "type": "object", "description": "Notion filter object (optional)." },
          "max": { "type": "integer", "description": "Max results (default 10)." }
        },
        "required": ["databaseId"]
      }
    }
  ],
  "permissions": [
    "network.notion",
    "keychain_read",
    "keychain_write"
  ],
  "tags": ["notion", "notes", "database", "productivity"],
  "homepage": "https://github.com/your-username/NativeAgent",
  "license": "MIT"
}
